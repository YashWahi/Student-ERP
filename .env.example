# Vite Firebase emulator configuration. Copy to .env.local (git-ignored).
# Never place a Razorpay Key Secret or any VITE_RAZORPAY_KEY_SECRET here.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-test
VITE_FIREBASE_AUTH_DOMAIN=demo-test.firebaseapp.com

# Optional public checkout-key fallback. Normally the frontend obtains this
# from getRazorpayPublicKey, so this can remain commented.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Local development overrides — NEVER commit real secrets in this file.
# Copy to `.env.local` (git-ignored) and fill in your own Razorpay TEST values.
#
# The Key Secret must NEVER appear in frontend code or any committed file.
# Server-side secret is configured with:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET

# Optional: public Test Key ID fallback used only if the
# getRazorpayPublicKey callable is unreachable during local dev.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Firebase project config (Vite). Without overrides, the app uses project cafe-265bd.
# Override these values only when targeting another Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
