# Local development placeholders — NEVER commit real secrets.
# For the REAL Razorpay Test API with the Functions Emulator, copy this file to:
#   .env.demo-test.local
# Then enter your own Razorpay TEST Key ID and TEST Key Secret in that ignored file.
# The Firebase CLI loads that file when using --project demo-test.
# Do not use a live key here.

RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_test_key_secret
